# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/avara-sl

# Authentication
# Generate strong secrets (for example: openssl rand -hex 32). Never use placeholder values in production.
JWT_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-separate-random-secret

# Scheduled rent reminders
# Also configure the same value as the GitHub Actions RENT_REMINDER_SECRET repository secret.
RENT_REMINDER_SECRET=replace-with-a-long-random-cron-secret

# AWS S3 Configuration
S3_ACCESS_KEY_ID=your-aws-access-key-id
S3_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_REGION=us-east-1
S3_BUCKET=avara-sl

# Payment Providers
PAYHERE_MERCHANT_ID=your-payhere-merchant-id
PAYHERE_SECRET=your-payhere-secret-key

# WhatsApp Cloud API (preferred)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# Legacy alias supported for the WhatsApp access token
WHATSAPP_API_KEY=your-whatsapp-api-key

# Twilio SMS / WhatsApp fallback
TWILIO_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000
TWILIO_WHATSAPP_FROM=+10000000000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
