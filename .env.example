MONGODB_URI=

# Auth - use non-placeholder random values of at least 32 characters
JWT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Scheduled rent reminder authentication
RENT_REMINDER_SECRET=

# AWS S3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=

# WhatsApp Cloud API (preferred)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Legacy alias supported for the WhatsApp access token
WHATSAPP_API_KEY=

# Twilio SMS / WhatsApp fallback
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Other
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
